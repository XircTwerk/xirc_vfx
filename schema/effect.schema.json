        },
        "bounce": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "texture": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?!.*\\.\\.)(?!.*//)[a-z0-9_.-]+:textures/[a-z0-9_./-]+\\.png$",
          "default": "xirc_vfx_studio:textures/effect/soft.png"
        },
        "glow": {
          "type": "boolean",
          "default": true
        },
        "fade": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3
        },
        "length": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 128,
          "default": 3
        },
        "trailPoints": {
          "type": "integer",
          "minimum": 2,
          "maximum": 64,
          "default": 12
        },
        "pixelSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 1
        },
        "meshScale": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0.001,
              "maximum": 8
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 8
                },
                "max": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 8
                }
              },
              "required": [
                "min",
                "max"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "curve": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "time": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0.001,
                        "maximum": 8
                      },
                      "easing": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "mode": {
                            "type": "string",
                            "enum": [
                              "linear",
                              "step",
                              "smooth",
                              "bezier"
                            ],
                            "default": "linear"
                          },
                          "controls": {
                            "type": "array",
                            "items": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "minItems": 4,
                            "maxItems": 4
                          }
                        },
                        "required": [],
                        "allOf": [
                          {
                            "if": {
                              "required": [
                                "mode"
                              ],
                              "properties": {
                                "mode": {
                                  "const": "bezier"
                                }
                              }
                            },
                            "then": {
                              "required": [
                                "controls"
                              ]
                            },
                            "else": {
                              "not": {
                                "required": [
                                  "controls"
                                ]
                              }
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "time",
                      "value"
                    ]
                  },
                  "minItems": 2,
                  "maxItems": 64
                }
              },
              "required": [
                "curve"
              ]
            }
          ],
          "default": 1
        },
        "bloom": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "default": 0
        },
        "blend": {
          "type": "string",
          "enum": [
            "alpha",
            "additive"
          ],
          "default": "alpha"
        },
        "textureAnimation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 1
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 1
            },
            "frames": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "fps": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 120,
              "default": 20
            },
            "loop": {
              "type": "boolean",
              "default": true
            }
          },
          "required": []
        }
      },
      "required": [
        "id"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "pixelSize"
            ],
            "properties": {
              "pixelSize": {
                "minimum": 2
              }
            }
          },
          "then": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "slash",
                  "ring_mesh",
                  "cube_mesh",
                  "sphere_mesh",
                  "lightning"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "meshScale"
            ]
          },
          "then": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "slash",
                  "ring_mesh",
                  "cube_mesh",
                  "sphere_mesh",
                  "lightning"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "textureAnimation"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "particle",
                  "beam",
                  "trail"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "aspect"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "particle"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "alignVelocity"
                ]
              },
              {
                "required": [
                  "stretch"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "particle"
              }
            }
          }
        }
      ]
    }
  },
  "description": "Canonical standalone effect format. Runtime additionally checks hierarchy, sorted keyframes, min<=max, burst times, resources and particle budgets. Photon imports convert to this format with explicit diagnostics; no Photon runtime dependency."
}
