                            "minItems": 4,
                            "maxItems": 4
                          }
                        },
                        "required": [],
                        "allOf": [
                          {
                            "if": {
                              "required": [
                                "mode"
                              ],
                              "properties": {
                                "mode": {
                                  "const": "bezier"
                                }
                              }
                            },
                            "then": {
                              "required": [
                                "controls"
                              ]
                            },
                            "else": {
                              "not": {
                                "required": [
