                          "mode": {
                            "type": "string",
                            "enum": [
                              "linear",
                              "step",
                              "smooth",
                              "bezier"
                            ],
                            "default": "linear"
                          },
                          "controls": {
                            "type": "array",
                            "items": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
