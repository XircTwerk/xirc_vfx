                            "minItems": 4,
                            "maxItems": 4
                          }
                        },
                        "required": [],
                        "allOf": [
                          {
                            "if": {
                              "required": [
                                "mode"
                              ],
                              "properties": {
                                "mode": {
                                  "const": "bezier"
                                }
                              }
                            },
                            "then": {
                              "required": [
                                "controls"
                              ]
                            },
                            "else": {
                              "not": {
                                "required": [
                                  "controls"
                                ]
                              }
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "time",
                      "value"
                    ]
                  },
                  "minItems": 2,
                  "maxItems": 64
                }
              },
              "required": [
                "curve"
              ]
            }
          ],
          "default": 0.1
