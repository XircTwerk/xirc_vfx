{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!.*\\.\\.)(?!.*//)[a-z0-9_.-]+:[a-z0-9_./-]*[a-z0-9_-]$"
    },
    "name": {
      "type": "string",
      "maxLength": 512
    },
    "author": {
      "type": "string",
      "maxLength": 512,
      "default": "Xirc"
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "duration": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 300,
      "default": 5
    },
    "autoDuration": {
      "type": "boolean",
      "default": false
    },
    "pivot": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -128,
        "maximum": 128
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        0,
        0,
        0
      ]
    },
    "wind": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [
        0,
        0,
        0
      ]
    },
    "loop": {
      "type": "boolean",
      "default": false
    },
    "seed": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "default": 0
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "time": {
            "type": "number",
            "minimum": 0,
            "maximum": 631
          }
        },
        "required": [
          "name",
          "time"
        ]
      },
      "minItems": 0,
      "maxItems": 64
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "label": {
            "type": "string",
            "maxLength": 128
          },
          "min": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "max": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "value": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "layer": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "property": {
                  "enum": [
                    "size",
                    "speed",
                    "rotation",
                    "lifetime",
                    "meshScale",
                    "opacity",
                    "spin",
                    "aspect",
                    "start",
                    "duration",
                    "rate",
                    "radius",
                    "length",
                    "spread",
                    "drag",
                    "noise",
                    "bloom",
                    "fade",
                    "bounce"
                  ]
                },
                "scale": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "offset": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                }
              },
              "required": [
                "layer",
                "property"
              ]
            },
            "minItems": 1,
            "maxItems": 64
          }
        },
        "required": [
          "name",
          "min",
          "max",
          "value",
          "targets"
        ]
      },
      "minItems": 0,
      "maxItems": 32
    },
    "emitters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/emitter"
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "emitters"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XircTwerk/xirc_vfx_studio/blob/main/schema/effect.schema.json",
  "title": "Xirc's VFX Studio effect v1",
  "$defs": {
    "emitter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "parent": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]{0,63})?$",
          "default": ""
        },
        "folder": {
          "type": "string",
          "maxLength": 64,
          "default": ""
        },
        "kind": {
          "type": "string",
          "enum": [
            "particle",
            "beam",
            "trail",
            "slash",
            "ring_mesh",
            "cube_mesh",
            "sphere_mesh",
            "lightning"
          ],
          "default": "particle"
        },
        "space": {
          "type": "string",
          "enum": [
            "local",
            "world"
          ],
          "default": "local"
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -128,
            "maximum": 128
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [
            0,
            0,
            0
          ]
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pathInterpolation": {
              "type": "string",
              "enum": [
                "linear",
                "spline"
              ],
              "default": "linear"
            },
            "rotation": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -36000,
                "maximum": 36000
              },
              "minItems": 3,
              "maxItems": 3,
              "default": [
                0,
                0,
                0
              ]
            },
            "scale": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 8,
              "default": 1
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "time": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 631
                  },
                  "position": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -128,
                      "maximum": 128
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "default": [
                      0,
                      0,
                      0
                    ]
                  },
                  "rotation": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -36000,
                      "maximum": 36000
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "default": [
                      0,
                      0,
                      0
                    ]
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 8,
                    "default": 1
                  },
                  "easing": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "linear",
                          "step",
                          "smooth",
                          "bezier"
                        ],
                        "default": "linear"
                      },
                      "controls": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "minItems": 4,
                        "maxItems": 4
                      }
                    },
                    "required": [],
                    "allOf": [
                      {
                        "if": {
                          "required": [
                            "mode"
                          ],
                          "properties": {
                            "mode": {
                              "const": "bezier"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "controls"
                          ]
                        },
                        "else": {
                          "not": {
                            "required": [
                              "controls"
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "time"
                ]
              },
              "minItems": 2,
              "maxItems": 64
            }
          },
          "required": []
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 300,
          "default": 0
        },
        "duration": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 300
        },
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000,
          "default": 30
        },
        "bursts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "time": {
                "type": "number",
                "minimum": 0,
                "maximum": 300,
                "default": 0
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000,
                "default": 1
              }
            },
            "required": []
